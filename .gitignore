__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ---- 数据库 / 大数据 (不进 git,按 README 指引重建) ----
*.db
*.db.bak*
*.sqlite
*.sqlite3
data/throttle_knowledge.db
data/throttle_knowledge.db.bak*
throttle_knowledge.db      # 根目录残留空文件

# 专利原始 JSON 抓取池 (按需重建,54M+)
data/source_archive/
data/knowledge_base/_generated/

# ---- WorkBuddy 会话记忆 (含内部决策, 不进 git) ----
.workbuddy/

# ---- 凭据 / 环境 ----
.env
.env.*
*.secret
secrets.yaml
credentials.json

# ---- 系统 ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---- IDE ----
.vscode/
.idea/
*.iml

# ---- 日志 ----
*.log
logs/

